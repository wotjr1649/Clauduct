/.clauduct-profile/
/.clauduct-status/
/output/
/.tmp/

# Session prompts, handoffs and agent instructions: working material that stays on the
# machine that wrote them. The whole directory, with no exceptions, because an exception
# list is how this stops being a boundary.
/docs/prompts/
/AGENTS.md

# Tests, test inputs and verification evidence. They stay on the maintainer's disk and in a
# local-only branch, never in the public history (v0.3.3). The public tree is the product,
# its documents and its installer; the checks that guard it run locally before a push.
/verification/
/go/**/*_test.go
/go/internal/app/testdata/
/go/internal/upstream/testdata/
/go/.verification/
/go/internal/app/native_events_publication_test.mjs

# Worktrees an isolated subagent checks out under the project.
#
# The directory beside them is not ignored: .claude is where a project shares agent
# configuration, and hiding all of it would hide something this repository may one day want
# tracked. Only the checkouts, which are disposable by construction.
#
# Written 2026-09-18, after a code-review agent left one behind: 12MB, registered with git
# and locked, so `git worktree prune` would not have taken it either. Removing one is
# `git worktree unlock` then `git worktree remove` -- deleting the directory leaves the
# registration and the worktree's branch behind.
/.claude/worktrees/

# Markers written by live validation runs.
/clauduct-check.txt
/clauduct-agent-validation-*.txt
